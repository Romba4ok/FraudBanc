FROM node:22-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/index.html ./
COPY frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/vite.config.ts ./
COPY frontend/src ./src
RUN npm run build

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    RISK_LEDGER_STATIC_DIR=/app/static \
    RISK_LEDGER_SESSION_DIR=/tmp/risk-ledger/sessions \
    RISK_LEDGER_MODEL_REGISTRY_DIR=/tmp/risk-ledger/model-registry \
    RISK_LEDGER_MAX_INPUT_BYTES=524288000 \
    RISK_LEDGER_MAX_INPUT_RECORDS=1000000

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/app/__init__.py ./app/__init__.py
RUN python -m pip install --upgrade pip \
    && python -m pip install .

COPY backend/app ./app
RUN python -m pip install . --no-deps

COPY backend/artifacts/current/manifest.json backend/artifacts/current/model.cbm ./artifacts/current/
COPY backend/artifacts/transaction/current/manifest.json backend/artifacts/transaction/current/model.joblib ./artifacts/transaction/current/
COPY --from=frontend-build /frontend/dist ./static

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app \
    && mkdir -p /tmp/risk-ledger \
    && chown -R app:app /app /tmp/risk-ledger

USER app
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
